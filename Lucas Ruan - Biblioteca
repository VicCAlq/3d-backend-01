CREATE TABLE biblioteca (
id INTEGER PRIMARY KEY AUTOINCREMENT,
nome_do_livro VARCHAR(50) NOT NULL,
categoria VARCHAR(50) NOT NULL,
autor VARCHAR(100) NOT NULL,
ano_de_lancamento INTEGER NOT NULL
);

